{
  "templates": [
    {
      "id": "outreach-01-opener",
      "name": "1. Opener - the problem",
      "file": "outreach-01-opener.html",
      "description": "Opens on the prospect's own situation using researched evidence, then introduces the product as one possible answer. Ends with a question, not a demo link.",
      "bestFor": [
        "Step 1 of a cold sequence",
        "IT staffing and RPO prospects",
        "Evidence-based personalisation"
      ],
      "mergeFields": [
        "{{first_name}}",
        "{{observation}}"
      ],
      "category": "sequence",
      "colors": [
        "#1a1a1a",
        "#ffffff",
        "#e4e4e4"
      ],
      "features": {
        "hasHeader": false,
        "hasFooter": false,
        "hasButton": false,
        "plainStyle": true,
        "responsive": true
      },
      "sequence": {
        "step": 1,
        "waitDays": 0
      },
      "defaultSubject": "Preliminary screening for {{role_examples}}"
    },
    {
      "id": "outreach-02-reminder",
      "name": "2. Reminder",
      "file": "outreach-02-reminder.html",
      "description": "A short nudge on the same thread. Repeats the question rather than the pitch.",
      "bestFor": [
        "2-3 business days after the opener"
      ],
      "mergeFields": [
        "{{first_name}}"
      ],
      "category": "sequence",
      "colors": [
        "#1a1a1a",
        "#ffffff",
        "#e4e4e4"
      ],
      "features": {
        "hasHeader": false,
        "hasFooter": false,
        "hasButton": false,
        "plainStyle": true,
        "responsive": true
      },
      "sequence": {
        "step": 2,
        "waitDays": 3
      }
    },
    {
      "id": "outreach-03-their-process",
      "name": "3. Ask about their process",
      "file": "outreach-03-their-process.html",
      "description": "Asks how they screen today. Invites a reply even from someone who will never buy, which is still worth more than silence.",
      "bestFor": [
        "3-4 business days after the reminder"
      ],
      "mergeFields": [
        "{{first_name}}"
      ],
      "category": "sequence",
      "colors": [
        "#1a1a1a",
        "#ffffff",
        "#e4e4e4"
      ],
      "features": {
        "hasHeader": false,
        "hasFooter": false,
        "hasButton": false,
        "plainStyle": true,
        "responsive": true
      },
      "sequence": {
        "step": 3,
        "waitDays": 4
      }
    },
    {
      "id": "outreach-04-use-case",
      "name": "4. Specific use case",
      "file": "outreach-04-use-case.html",
      "description": "One concrete scenario in their own domain. The first message that describes the product in any detail.",
      "bestFor": [
        "4-5 business days after the process question"
      ],
      "mergeFields": [
        "{{first_name}}",
        "{{role_examples}}"
      ],
      "category": "sequence",
      "colors": [
        "#1a1a1a",
        "#ffffff",
        "#e4e4e4"
      ],
      "features": {
        "hasHeader": false,
        "hasFooter": false,
        "hasButton": false,
        "plainStyle": true,
        "responsive": true
      },
      "sequence": {
        "step": 4,
        "waitDays": 5
      }
    },
    {
      "id": "outreach-05-break-up",
      "name": "5. Break-up",
      "file": "outreach-05-break-up.html",
      "description": "Closes the loop and stops. Often the highest-reply message in a sequence, because it asks for nothing.",
      "bestFor": [
        "Final step",
        "Leaving the door open"
      ],
      "mergeFields": [
        "{{first_name}}"
      ],
      "category": "sequence",
      "colors": [
        "#1a1a1a",
        "#ffffff",
        "#e4e4e4"
      ],
      "features": {
        "hasHeader": false,
        "hasFooter": false,
        "hasButton": false,
        "plainStyle": true,
        "responsive": true
      },
      "sequence": {
        "step": 5,
        "waitDays": 6
      }
    }
  ],
  "categories": [
    {
      "id": "sequence",
      "name": "Cold Outreach Sequence",
      "description": "A five-step prospecting sequence. Plain by design - no images, no buttons, no colour blocks - so it reads as a person writing rather than a campaign. Use the steps in order."
    }
  ],
  "mergeFieldsGuide": {
    "{{first_name}}": "Recipient's first name",
    "{{last_name}}": "Recipient's last name",
    "{{company}}": "Recipient's company name",
    "{{email}}": "Recipient's email address"
  }
}
