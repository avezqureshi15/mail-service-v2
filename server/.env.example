# ---------------------------------------------------------------------------
# mail-service-v2 - environment template
#
# Copy to `.env` and fill in. The server validates every variable at boot and
# REFUSES TO START if a required one is missing - there are no fallback
# defaults for secrets. Never commit a filled-in .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Public base URL of THIS service. Used to build unsubscribe links, so it must
# be the externally reachable HTTPS URL in production.
APP_BASE_URL=http://localhost:4000

# Origin allowed to call the API (the React app).
WEB_ORIGIN=http://localhost:5173

# --- Secrets ---------------------------------------------------------------
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Signs unsubscribe and tracking tokens. Rotating it invalidates live links.
TOKEN_HMAC_SECRET=
# Signs session cookies.
SESSION_SECRET=

# --- Database (Supabase Postgres) ------------------------------------------
# IMPORTANT: use the CONNECTION POOLER host, not db.<ref>.supabase.co.
# The direct host publishes only an AAAA record, so on an IPv4 network it
# simply times out with no useful error.
#
# Copy the exact string from: Supabase dashboard > Connect > Session pooler.
# It looks like:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Session mode (port 5432) is the right one for this app: it behaves like a
# real Postgres connection, so transactions and prepared statements work.
# Transaction mode (6543) is for serverless and breaks both.
DATABASE_URL=

# Schema to use. Tests set this to something else so they cannot truncate
# real tables while sharing a project with production.
DATABASE_SCHEMA=public
DATABASE_POOL_MAX=10

# Optional: paste Supabase's CA certificate to verify the server certificate.
# Without it the connection is still encrypted, just not verified.
DATABASE_CA=

# --- Sending identity ------------------------------------------------------
SENDING_DOMAIN=
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=
MAIL_REPLY_TO=
# DKIM selector configured in the Zoho admin console.
DKIM_SELECTOR=zoho
# CAN-SPAM requires a real postal address in every commercial email.
COMPANY_POSTAL_ADDRESS=

# --- Zoho SMTP -------------------------------------------------------------
# Match the host to your Zoho data centre - check the URL you sign in to Zoho
# Mail with: smtp.zoho.com | .in | .eu | .com.au
#
# The data centre must also match the SPF include on your domain
# (smtp.zoho.in pairs with include:zoho.in). A mismatch here authenticates
# nothing and every message fails SPF.
#
# If the domain already sends through another provider (Google Workspace,
# Microsoft 365, Brevo), ADD the Zoho include to the existing SPF record -
# never replace it, or you break your normal company email.
# `npm run dns:plan -- --domain yourdomain.com --dc in` prints the merged
# record computed from what is actually published.
SMTP_HOST=smtp.zoho.com
# 465 = implicit TLS (recommended). 587 = STARTTLS.
SMTP_PORT=465
SMTP_USER=
# Use a Zoho application-specific password, not the account password:
# Zoho Account > Security > App Passwords.
SMTP_PASSWORD=

# --- Zoho IMAP (bounce + reply detection) ----------------------------------
IMAP_ENABLED=true
IMAP_HOST=imap.zoho.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_POLL_SECONDS=120

# --- Click/open tracking (opt-in per campaign) -----------------------------
# A subdomain of SENDING_DOMAIN, CNAME'd to this service. Leave blank to
# disable tracking entirely. Never use a shared third-party tracking domain.
TRACKING_DOMAIN=

# --- Admin bootstrap -------------------------------------------------------
# Read once by `npm run seed:admin`, then remove from the file.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
