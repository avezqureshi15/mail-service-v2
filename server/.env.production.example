# ---------------------------------------------------------------------------
# What to put into Render's environment variables.
#
# THIS FILE IS A CHECKLIST, NOT SOMETHING THE APP READS.
#
# Render injects environment variables into the process; it does not read a
# file from the image, and `.dockerignore` keeps every .env* out of the image
# anyway. So there is no `.env.production` to create - the real values live
# only in Render's dashboard.
#
# `server/.env` stays as it is. Its localhost values are correct for local
# development and should not be changed for deployment.
#
# Paste this into Render's "Add from .env" box, then fill in the five
# <PLACEHOLDER> values by copying them out of server/.env.
# ---------------------------------------------------------------------------

# Must be production. Render's variables override the image's own ENV, so
# leaving this at `development` downgrades the session cookie from Secure and
# stops the app trusting Render's proxy - which also corrupts the client IP
# recorded against every unsubscribe.
NODE_ENV=production

# PORT IS DELIBERATELY ABSENT. Render injects it (default 10000) and the app
# reads it. Setting it to 4000 makes Render route to a port nothing is
# listening on: the deploy succeeds and every request fails.

# --- URLs ------------------------------------------------------------------
# Both point at the NETLIFY site, not at Render - Netlify proxies /api, /u and
# /t through to Render, so the browser only ever sees one origin.
#
# For the very first deploy Netlify does not exist yet. Put the Render URL in
# both, get the service booting, then come back and change them. Do not send a
# real campaign in between: unsubscribe links would resolve, but on a domain
# that is not yours.
#
# APP_BASE_URL is what unsubscribe links in your emails are built from.
APP_BASE_URL=https://YOUR-SITE.netlify.app
WEB_ORIGIN=https://YOUR-SITE.netlify.app

# Reverse proxies in front of this process. Netlify -> Caddy -> app is 2.
# Too low and every unsubscribe records the proxy IP instead of the
# recipient's; too high and a forged header can spoof one.
TRUST_PROXY_HOPS=2

# --- Secrets - copy the values from server/.env ----------------------------
# Rotating TOKEN_HMAC_SECRET invalidates every unsubscribe link already sitting
# in someone's inbox. Rotating SESSION_SECRET signs everyone out.
TOKEN_HMAC_SECRET=<copy from server/.env>
SESSION_SECRET=<copy from server/.env>

# The Supabase SESSION pooler string, port 5432 - not the direct
# db.<ref>.supabase.co host, which is IPv6-only, and not transaction mode
# (6543), which breaks transactions and prepared statements.
DATABASE_URL=<copy from server/.env>

DATABASE_SCHEMA=public
DATABASE_POOL_MAX=10

# --- Sending identity ------------------------------------------------------
SENDING_DOMAIN=webknot.in
MAIL_FROM_NAME=Avez at Webknot
MAIL_FROM_ADDRESS=avez@webknot.in
MAIL_REPLY_TO=avez@webknot.in

# Must be `google`. It defaults to `zoho`, and a wrong selector makes the
# domain-auth check fail, which auto-pauses every campaign.
DKIM_SELECTOR=google

# Legally required in every commercial email, and it blocks campaign start
# until set. Check this is your real registered address.
COMPANY_POSTAL_ADDRESS=Webknot Technologies, 42 Residency Road, Bengaluru, Karnataka 560025, India

MAIL_PROVIDER=google

# --- SMTP ------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=avez@webknot.in
SMTP_PASSWORD=<Gmail app password - copy from server/.env>

# --- IMAP (bounce and reply detection) -------------------------------------
# IMAP_HOST must be set. It defaults to imap.zoho.com, and if the poller
# cannot connect you lose bounce handling and reply detection silently - the
# two things that protect your sending reputation.
IMAP_ENABLED=true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=avez@webknot.in
IMAP_PASSWORD=<Gmail app password - copy from server/.env>
IMAP_POLL_SECONDS=120

# --- Optional --------------------------------------------------------------
# Leave blank unless you set up a tracking subdomain CNAME'd to the service.
TRACKING_DOMAIN=

# DO NOT SET SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD on Render. The admin
# account already exists in Supabase; those are local bootstrap values only.
