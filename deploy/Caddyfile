13-201-235-164.sslip.io {
    encode gzip

    request_body {
        max_size 12MB
    }

    handle {
        reverse_proxy 127.0.0.1:4000 {
            # TLS terminates here, so tell the app - it only issues Secure
            # cookies when it believes the request arrived over HTTPS.
            header_up X-Forwarded-Proto https

            # Caddy is the edge now. Nothing sits in front of it, so the peer
            # on the socket IS the visitor, and that is what the app should
            # see as the client.
            #
            # Overwritten rather than appended on purpose: a client-supplied
            # X-Forwarded-For would otherwise let anyone forge an address,
            # bypassing the per-IP rate limits and poisoning the IP recorded
            # against every unsubscribe.
            #
            # This previously read X-Nf-Client-Connection-Ip, because Netlify
            # sat in front and that was where the real visitor appeared. With
            # Netlify gone that header is never present, so the app was
            # seeing an empty XFF and falling back to Caddy's own loopback
            # address - putting every visitor on earth in one rate-limit
            # bucket.
            header_up X-Forwarded-For {http.request.remote.host}
        }
    }
}

# Deployed at /etc/caddy/Caddyfile on the EC2 instance (ap-south-1).
# Kept here so the server's configuration is version controlled rather than
# existing only on the box. After editing:
#   scp deploy/Caddyfile ubuntu@<ip>:/tmp/ && \
#     ssh ubuntu@<ip> 'sudo mv /tmp/Caddyfile /etc/caddy/ && sudo caddy validate \
#       --config /etc/caddy/Caddyfile --adapter caddyfile && sudo systemctl reload caddy'
